<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Store privacy manifest. Required because the app touches
	     UserDefaults (a "required reason" API): paired board ids, per-board
	     server pins, and the Keychain fallback for unsigned dev builds all
	     live there. CA92.1 = "access info from same app" — the app only ever
	     reads defaults it wrote itself. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<!-- Nothing identifying leaves the device: the server sees only an
	     app-generated Ed25519 pubkey (the pairing identity). No accounts, no
	     analytics, no third-party SDKs. -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
